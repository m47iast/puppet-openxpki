# System wide token (non key based tokens)
token:
    default:
        # ------------------------------------------------------------------
        # Original OpenSSL backend (disabled when using PKCS#11 / SoftHSM)
        # ------------------------------------------------------------------
        #backend: OpenXPKI::Crypto::Backend::OpenSSL
        #api:     OpenXPKI::Crypto::Backend::API
        #engine:  OpenSSL
        #key_store: OPENXPKI

        # OpenSSL binary location
        #shell: /usr/bin/openssl

        # OpenSSL binary call gets wrapped with this command
        #wrapper: ''

        # random file to use for OpenSSL
        #randfile: /var/openxpki/rand

        # ------------------------------------------------------------------
        # PKCS#11 backend (SoftHSM)
        # ------------------------------------------------------------------
        # The PKCS#11 backend uses a hardware or software HSM. In HLCS this
        # is SoftHSM2. The module path, slot, label and PIN must match the
        # token created during HSM initialization.
        backend: OpenXPKI::Crypto::Backend::PKCS11
        api:     OpenXPKI::Crypto::Backend::API
        engine:  PKCS11
        key_store: PKCS11

        # Path to the PKCS#11 provider library
        module: <%= @hsm_module_path %>

        # Slot number where the token resides
        slot: <%= @hsm_slot %>

        # Label of the default key to use
        label: <%= @hsm_token_label %>

        # User PIN for the token
        pin: <%= @hsm_pin %>

    javaks:
        backend: OpenXPKI::Crypto::Tool::CreateJavaKeystore
        api: OpenXPKI::Crypto::Tool::CreateJavaKeystore::API
        engine:  OpenSSL
        key_store: OPENXPKI
        shell: /usr/bin/keytool
        randfile: /var/openxpki/rand

    # Token for CA signing operations
    ca:
        backend: OpenXPKI::Crypto::Backend::PKCS11
        api:     OpenXPKI::Crypto::Backend::API
        engine:  PKCS11
        key_store: PKCS11

        module: <%= @hsm_module_path %>
        slot:   <%= @hsm_slot %>
        label:  <%= @hsm_ca_label %>
        pin:    <%= @hsm_pin %>

    # Token for OCSP signing operations
    ocsp:
        backend: OpenXPKI::Crypto::Backend::PKCS11
        api:     OpenXPKI::Crypto::Backend::API
        engine:  PKCS11
        key_store: PKCS11

        module: <%= @hsm_module_path %>
        slot:   <%= @hsm_slot %>
        label:  <%= @hsm_ocsp_label %>
        pin:    <%= @hsm_pin %>


# Secret group to be shared in all realms
secret:
    default:
        label: Global secret group
        export: 0
        method: literal
        value: root
        # if you want to enter the password after startup via the Webui
        # replace method and value above with this block, kcv is optional
        # but highly recommended as wrong passwords let the engine crash
        # you can generate the kcv with "openxpkiadm hashpwd -s argon2"
        # Shared secrets are avail in all realms after been unlocked in one
        #method: plain
        #cache: daemon
        #kcv: $argon2id$v=19$m=32768,t=3,p=1$R1VmZC9sQVJTdE05WDRReDBIMTlDUT09$KXsh6Ow1A9mIZtyAP2TXbA

    ratoken:
        label: Secret group for RA Token
        export: 1
        method: literal
        value: secret

    svault:
        label: Secret group for datavault encryption
        method: literal
        # please set your own key string here and keep it in a safe place
        # this must be 64 characters hex -> "openssl  rand -hex 32"
        value: <%= @svault_key %>
